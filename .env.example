# Database Configuration
# Path to the SQLite database file. Defaults to 'database.sqlite' in the root directory.
DATABASE_PATH=database.sqlite

# Security Configuration
# Secret key for syncing data. If set, clients must provide this in x-sync-key header.
SYNC_KEY=

# Client Configuration (Exposed to Browser)
# Default sync URL for the frontend. Use 'local' for the current server.
VITE_SYNC_URL=local
# Default sync key for the frontend. Should match SYNC_KEY if set.
VITE_SYNC_KEY=

# Server Configuration
PORT=3000
NODE_ENV=development
SYNC_KEY=your-secret-sync-key-here
